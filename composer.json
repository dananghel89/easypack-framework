{
	"name": "dananghel89/easypack-framework",
	"description": "EasyPack Framework",
	"type": "project",
	"require": {
		"php": ">=7.0",
		"altorouter/altorouter": "2.0.*",
		"clausnz/php-helpers": "0.2.*",
		"delight-im/db": "1.3.*",
		"league/plates": "3.5.*",
		"phpmailer/phpmailer": "6.8.*"
	},
	"require-dev": {
		"pestphp/pest": "^5.3",
		"laravel/pint": "^1.32"
	},
	"autoload": {
		"psr-4": {
			"Epack\\": "classes/"
		},
		"files": [
			"app/init.php"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "pest",
		"lint": "pint",
		"test:lint": "pint --test"
	},
	"config": {
		"allow-plugins": {
			"pestphp/pest-plugin": true
		}
	}
}
